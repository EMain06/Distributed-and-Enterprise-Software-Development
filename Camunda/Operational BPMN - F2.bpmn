        <bpmn:flowNodeRef>Event_0zvtabi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0vovoxi" name="Marketplace system">
        <bpmn:flowNodeRef>Activity_1ptggsq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_06co6gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1offh9r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0unwm8f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1f3go1e</bpmn:flowNodeRef>
