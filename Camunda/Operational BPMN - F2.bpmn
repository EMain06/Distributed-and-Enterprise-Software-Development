        <bpmn:flowNodeRef>Event_10154ea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0g3kk5x</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Inventory update requested">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=chatMessage" target="chatMessage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1alo21o</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0gqi1i4" name="Enter inventory update">
      <bpmn:documentation>Producer enters product ID, new total quantity and availability dates. On correction, retain previous values and display validationMessage.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_0kujifq" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cy18ox</bpmn:incoming>
      <bpmn:outgoing>Flow_05ca9ao</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1amddca">
      <bpmn:incoming>Flow_1alo21o</bpmn:incoming>
      <bpmn:incoming>Flow_1tzk3q5</bpmn:incoming>
      <bpmn:outgoing>Flow_0cy18ox</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_1apnwlf" name="Review save failure and choose action.">
      <bpmn:documentation>Display saveMessage and ask the producer to retry or cancel. Store the choice in saveAction as "retry" or "cancel".</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_1suxsm8" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qz4wgu</bpmn:incoming>
      <bpmn:outgoing>Flow_09k9mzm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0vsgljp" name="Retry update?">
      <bpmn:incoming>Flow_09k9mzm</bpmn:incoming>
      <bpmn:outgoing>Flow_1xywbzz</bpmn:outgoing>
      <bpmn:outgoing>Flow_1kxigs2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0zvtabi" name="Inventory update cancelled.">
      <bpmn:incoming>Flow_1xywbzz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0rm6d0s" sourceRef="Activity_1ptggsq" targetRef="Gateway_06co6gp" />
    <bpmn:sequenceFlow id="Flow_1b4dvjd" name="Valid" sourceRef="Gateway_06co6gp" targetRef="Activity_1offh9r">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=updateValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1tzk3q5" name="Invalid" sourceRef="Gateway_06co6gp" targetRef="Gateway_1amddca">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=updateValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05ca9ao" sourceRef="Activity_0gqi1i4" targetRef="Gateway_0g3kk5x" />
    <bpmn:sequenceFlow id="Flow_1ljvhzz" sourceRef="Activity_0unwm8f" targetRef="Gateway_1f3go1e" />
    <bpmn:sequenceFlow id="Flow_0ybynwk" name="Saved" sourceRef="Gateway_1f3go1e" targetRef="Activity_0vuukk4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=updateSaved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1qz4wgu" name="Not saved" sourceRef="Gateway_1f3go1e" targetRef="Activity_1apnwlf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=updateSaved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_172s1u4" sourceRef="Activity_0vuukk4" targetRef="Event_10154ea" />
    <bpmn:sequenceFlow id="Flow_1alo21o" sourceRef="StartEvent_1" targetRef="Gateway_1amddca" />
    <bpmn:sequenceFlow id="Flow_18xijxv" sourceRef="Activity_1offh9r" targetRef="Activity_0unwm8f" />
    <bpmn:sequenceFlow id="Flow_1kxigs2" name="Retry" sourceRef="Gateway_0vsgljp" targetRef="Gateway_0g3kk5x">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=saveAction = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0cy18ox" sourceRef="Gateway_1amddca" targetRef="Activity_0gqi1i4" />
    <bpmn:sequenceFlow id="Flow_09k9mzm" sourceRef="Activity_1apnwlf" targetRef="Gateway_0vsgljp" />
    <bpmn:sequenceFlow id="Flow_1xywbzz" name="Cancel" sourceRef="Gateway_0vsgljp" targetRef="Event_0zvtabi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=saveAction = "cancel"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1tbi8d3" sourceRef="Gateway_0g3kk5x" targetRef="Activity_1ptggsq" />
    <bpmn:serviceTask id="Activity_1ptggsq" name="Validate inventory update">
      <bpmn:documentation>Check product existence and producer ownership, quantity ≥ 0, and valid dates with end ≥ start. Return updateValid and validationMessage. Invalid submissions return for correction with values retained. Save no changes.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-inventory-update" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tbi8d3</bpmn:incoming>
      <bpmn:outgoing>Flow_0rm6d0s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_06co6gp" name="Update valid?">
      <bpmn:incoming>Flow_0rm6d0s</bpmn:incoming>
      <bpmn:outgoing>Flow_1tzk3q5</bpmn:outgoing>
      <bpmn:outgoing>Flow_1b4dvjd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1offh9r" name="Determine product availability.">
      <bpmn:documentation>Set productAvailable to true only when quantity &gt; 0, today falls within the availability dates, and the listing is permitted for sale. Otherwise, set it to false.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="determine-product-availability" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1b4dvjd</bpmn:incoming>
      <bpmn:outgoing>Flow_18xijxv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0unwm8f" name="Save inventory and availability">
      <bpmn:documentation>Save quantity, availability dates, and productAvailable together. Return updateSaved = true on success. Return false with saveMessage only when no changes were saved. Reconcile uncertain outcomes before retrying.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-inventory-and-availability" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18xijxv</bpmn:incoming>
      <bpmn:outgoing>Flow_1ljvhzz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1f3go1e" name="Update saved?">
      <bpmn:incoming>Flow_1ljvhzz</bpmn:incoming>
      <bpmn:outgoing>Flow_0ybynwk</bpmn:outgoing>
      <bpmn:outgoing>Flow_1qz4wgu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0vuukk4" name="Send update confirmation.">
      <bpmn:documentation>Notify the producer that the update was saved, including the product ID, quantity, availability dates and resulting availability status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-inventory-update-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ybynwk</bpmn:incoming>
      <bpmn:outgoing>Flow_172s1u4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_10154ea" name="Inventory update completed.">
      <bpmn:incoming>Flow_172s1u4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0g3kk5x">
      <bpmn:incoming>Flow_05ca9ao</bpmn:incoming>
      <bpmn:incoming>Flow_1kxigs2</bpmn:incoming>
      <bpmn:outgoing>Flow_1tbi8d3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:process id="Process_1jp1ayl" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_13ig0wm" sourceRef="Event_0k45zlo" targetRef="Activity_084xcvu" />
    <bpmn:sequenceFlow id="Flow_1kfgexn" sourceRef="Activity_084xcvu" targetRef="Activity_16vc9yt" />
    <bpmn:serviceTask id="Activity_084xcvu" name="Recalculate seasonal availability">
      <bpmn:documentation>Read current product records. Determine availability using quantity, latest seasonal dates and permission to sell. Include the whole end date using the marketplace timezone. Prepare changed availability values for saving.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="recalculate-seasonal-availability" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13ig0wm</bpmn:incoming>
      <bpmn:outgoing>Flow_1kfgexn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_16vc9yt" name="Save availability changes">
      <bpmn:documentation>Save changed availability values only if the product records have not changed since recalculation. Recheck updated records before saving to avoid overwriting newer producer updates.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-seasonal-availability" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kfgexn</bpmn:incoming>
      <bpmn:outgoing>Flow_1q22753</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1vi6n7x" name="Availability check completed.">
      <bpmn:incoming>Flow_1q22753</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1q22753" sourceRef="Activity_16vc9yt" targetRef="Event_1vi6n7x" />
    <bpmn:startEvent id="Event_0k45zlo" name="Daily Availability check">
      <bpmn:outgoing>Flow_13ig0wm</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_09wt4e2">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
  </bpmn:process>
