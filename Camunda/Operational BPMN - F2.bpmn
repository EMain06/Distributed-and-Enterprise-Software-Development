  <bpmn:collaboration id="Collaboration_1lmr07a" name="Operational BPMN - F2">
    <bpmn:participant id="Participant_1t4g5dy" name="Inventory update process" processRef="Process_0byk59e" />
    <bpmn:participant id="Participant_071t6mw" name="Scheduled availability maintenance" processRef="Process_1jp1ayl" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0byk59e" name="New BPMN diagram" isExecutable="true">
    <bpmn:laneSet id="LaneSet_02b1sb2">
      <bpmn:lane id="Lane_1cxqfx5" name="Producer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
